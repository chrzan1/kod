def use_herb(
    player_hp,
    max_player_hp,
    inventory
):

    print("1 - Zielona roślinka")
    print(
        "2 - Zielona + czerwona roślinka"
    )

    print("3 - Nie lecz się")

    choice = input("Wybierz opcję: ")

    if choice == "1":

        if inventory["green_herb"] > 0:

            player_hp += 40

            if player_hp > max_player_hp:

                player_hp = max_player_hp

            inventory["green_herb"] -= 1

            print(
                "Użyłeś zielonej roślinki"
            )

        else:

            print(
                "Nie masz zielonej roślinki"
            )

    elif choice == "2":

        if (
            inventory["green_herb"] > 0
            and inventory["red_herb"] > 0
        ):

            player_hp = max_player_hp

            inventory["green_herb"] -= 1
            inventory["red_herb"] -= 1

            print("Masz pełne HP")

        else:

            print(
                "Nie masz odpowiednich roślinek"
            )

    return player_hp, inventory


def choose_weapon(
    inventory,
    player_mana
):

    if len(inventory["weapons"]) == 0:

        return None

    weapon_names = list(
        inventory["weapons"].keys()
    )

    print("Wybierz broń:")

    for i in range(len(weapon_names)):

        weapon_name = weapon_names[i]

        upgrade_damage = 0

        for upgrade in inventory["weapons"][weapon_name]:

            upgrade_damage += (
                Weapon_Upgrades[upgrade]["damage_bonus"]
            )

        total_bonus = (
            Weapons[weapon_name]["damage_bonus"]
            + upgrade_damage
        )

        print(
            i + 1,
            "-",
            weapon_name,
            "damage +",
            total_bonus,
            "mana:",
            Weapons[weapon_name]["mana_cost"],
            "ulepszenia:",
            inventory["weapons"][weapon_name]
        )

    print(
        len(weapon_names) + 1,
        "- Bez broni"
    )

    choice = int(
        input("Wybierz opcję: ")
    )

    if (
        choice
        == len(weapon_names) + 1
    ):

        return None

    weapon_name = (
        weapon_names[choice - 1]
    )

    if (
        player_mana
        >= Weapons[weapon_name]["mana_cost"]
    ):

        return weapon_name

    print("Nie masz wystarczająco many")

    return None


def fight(
    player,
    enemy_name,
    gold,
    inventory
):

    player_data = Classes[player]
    enemy_data = Classes[enemy_name]

    player_hp = player_data["hp"]

    max_player_hp = player_data["hp"]

    enemy_hp = enemy_data["hp"]

    player_mana = player_data["mana"]

    round_counter = 1

    print(player, "vs", enemy_name)

    bosses = [
        "MR.X",
        "NEMESIS",
        "ALBERT WESKER"
    ]

    mini_bosses = [
        "Brutal Zombie",
        "Lizacz",
        "Chainsaw Zombie",
        "Annete Birkin",
        "William Birkin"
    ]

    if enemy_name in bosses:

        enemy_attack_round = 3

    elif enemy_name in mini_bosses:

        enemy_attack_round = 2

    else:

        enemy_attack_round = 1

    while (
        player_hp > 0
        and enemy_hp > 0
    ):

        print(
            "===== RUNDA",
            round_counter,
            "====="
        )

        print(player, "HP:", player_hp)
        print(player, "Mana:", player_mana)

        print(
            "Zielone roślinki:",
            inventory["green_herb"]
        )

        print(
            "Czerwone roślinki:",
            inventory["red_herb"]
        )

        print(
            "Bronie:",
            inventory["weapons"]
        )

        print("1 - Atak")
        print("2 - Leczenie")

        if player == "Leon S. Kennedy":

            print("3 - Wezwij Ada Wong")
            print("4 - Wezwij Sherry Birkin")

        action = input("Wybierz akcję: ")

        if action == "2":

            player_hp, inventory = use_herb(
                player_hp,
                max_player_hp,
                inventory
            )

        else:

            damage = player_data["damage"]

            weapon_name = choose_weapon(
                inventory,
                player_mana
            )

            if weapon_name is not None:

                upgrade_damage = 0

                for upgrade in inventory["weapons"][weapon_name]:

                    upgrade_damage += (
                        Weapon_Upgrades[upgrade]["damage_bonus"]
                    )

                damage += (
                    Weapons[weapon_name]["damage_bonus"]
                    + upgrade_damage
                )

                player_mana -= (
                    Weapons[weapon_name]["mana_cost"]
                )

                print("Użyłeś:", weapon_name)

            if (
                random.randint(1, 100)
                <= player_data.get(
                    "crit_chance",
                    0
                )
            ):

                damage = player_data[
                    "crit_damage"
                ]

                print("Cios krytyczny!")

            enemy_hp -= damage

            print(
                player,
                "zadał",
                damage,
                "obrażeń"
            )

            print(
                enemy_name,
                "HP:",
                max(enemy_hp, 0)
            )

            if enemy_hp <= 0:

                print(
                    player,
                    "wygrał walkę"
                )

                gained_gold = enemy_data.get(
                    "gold_drop",
                    0
                )

                gold += gained_gold

                print(
                    "Zdobyłeś",
                    gained_gold,
                    "gold"
                )

                print(
                    "Masz teraz",
                    gold,
                    "gold"
                )

                gold, inventory = merchant(
                    gold,
                    inventory
                )

                return (
                    gold,
                    inventory,
                    True
                )

        if enemy_hp > 0:

            if (
                round_counter
                % enemy_attack_round
                == 0
            ):

                enemy_damage = enemy_data[
                    "damage"
                ]

                player_hp -= enemy_damage

                print(
                    enemy_name,
                    "zadał",
                    enemy_damage,
                    "obrażeń"
                )

                print(
                    player,
                    "HP:",
                    max(player_hp, 0)
                )

            else:

                print(
                    enemy_name,
                    "przygotowuje atak"
                )

        player_mana += 5

        round_counter += 1

    if player_hp <= 0:

        print(
            player,
            "przegrał walkę"
        )

        return (
            gold,
            inventory,
            False
        )

    return (
        gold,
        inventory,
        True
    )
