def get_upgrade_limit(weapon_name):

    if weapon_name == "Matylda" or weapon_name == "Glock-18":

        return 2

    elif weapon_name == "MP-7":

        return 3

    elif weapon_name == "Strzelba pompka":

        return 2

    elif weapon_name == "Karabin Cobra":

        return 3

    elif weapon_name == "Karabin snajperski":

        return 3

    elif weapon_name == "Lightning Hawk":

        return 3

    return 0


def buy_weapon(
    gold,
    inventory,
    weapon_name
):

    price = Weapons[weapon_name]["price"]

    if weapon_name in inventory["weapons"]:

        print("Masz już tę broń")

        return gold, inventory

    if gold >= price:

        inventory["weapons"][weapon_name] = []

        gold -= price

        print("Kupiłeś", weapon_name)

    else:

        print("Nie masz wystarczająco gold")

    return gold, inventory


def buy_upgrade(
    gold,
    inventory
):

    if len(inventory["weapons"]) == 0:

        print("Nie masz żadnej broni")

        return gold, inventory

    weapon_names = list(
        inventory["weapons"].keys()
    )

    print("Wybierz broń do ulepszenia:")

    for i in range(len(weapon_names)):

        weapon_name = weapon_names[i]

        print(
            i + 1,
            "-",
            weapon_name,
            "ulepszenia:",
            inventory["weapons"][weapon_name]
        )

    weapon_choice = int(
        input("Wybierz broń: ")
    )

    chosen_weapon = (
        weapon_names[weapon_choice - 1]
    )

    limit = get_upgrade_limit(
        chosen_weapon
    )

    if (
        len(
            inventory["weapons"][chosen_weapon]
        )
        >= limit
    ):

        print(
            "Ta broń ma już maksymalną liczbę ulepszeń"
        )

        return gold, inventory

    upgrade_names = list(
        Weapon_Upgrades.keys()
    )

    print("Wybierz ulepszenie:")

    for i in range(len(upgrade_names)):

        upgrade_name = upgrade_names[i]

        print(
            i + 1,
            "-",
            upgrade_name,
            "damage +",
            Weapon_Upgrades[upgrade_name]["damage_bonus"],
            "koszt",
            Weapon_Upgrades[upgrade_name]["price"],
            "gold"
        )

    upgrade_choice = int(
        input("Wybierz ulepszenie: ")
    )

    chosen_upgrade = (
        upgrade_names[upgrade_choice - 1]
    )

    price = Weapon_Upgrades[
        chosen_upgrade
    ]["price"]

    if gold >= price:

        inventory["weapons"][
            chosen_weapon
        ].append(chosen_upgrade)

        gold -= price

        print(
            "Dodano",
            chosen_upgrade,
            "do broni",
            chosen_weapon
        )

    else:

        print(
            "Nie masz wystarczająco gold"
        )

    return gold, inventory


def sell_weapon(
    gold,
    inventory
):

    if len(inventory["weapons"]) == 0:

        print("Nie masz żadnej broni")

        return gold, inventory

    weapon_names = list(
        inventory["weapons"].keys()
    )

    print("Twoje bronie:")

    for i in range(len(weapon_names)):

        weapon_name = weapon_names[i]

        sell_price = (
            Weapons[weapon_name]["price"] // 3
        )

        print(
            i + 1,
            "-",
            weapon_name,
            "sprzedaż za",
            sell_price,
            "gold"
        )

    weapon_choice = int(
        input(
            "Którą broń chcesz sprzedać?: "
        )
    )

    sold_weapon = (
        weapon_names[weapon_choice - 1]
    )

    gained_gold = (
        Weapons[sold_weapon]["price"] // 3
    )

    gold += gained_gold

    del inventory["weapons"][sold_weapon]

    print(
        "Sprzedałeś",
        sold_weapon,
        "za",
        gained_gold,
        "gold"
    )

    return gold, inventory


