def choose_player():

    playable_characters = []

    for name in Classes:

        if Classes[name]["type"] == "playable":

            playable_characters.append(name)

    print("Wybierz bohatera:")

    for i in range(len(playable_characters)):

        print(i + 1, "-", playable_characters[i])

    choice = int(input("Podaj numer bohatera: "))

    return playable_characters[choice - 1]


def choose_free_locations():

    location_names = list(Locations.keys())

    chosen_locations = []

    while True:

        print("Wybierz miejscówkę:")

        for i in range(len(location_names)):

            print(i + 1, "-", location_names[i])

        print(len(location_names) + 1, "- Start gry")

        choice = int(input("Wybierz opcję: "))

        if choice == len(location_names) + 1:

            break

        chosen_locations.append(
            location_names[choice - 1]
        )

    return chosen_locations


